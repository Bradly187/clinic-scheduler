@typeparam TItem

@* A dropdown over rows identified by an integer key, showing a readable label for the selection. *@
<MudSelect T="int?" Value="Value" ValueChanged="ValueChanged" Label="@Label" ToStringFunc="Display"
           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="Clearable"
           Disabled="Disabled" HelperText="@HelperText" Class="@Class">
    @foreach (var item in Items)
    {
        <MudSelectItem T="int?" Value="@((int?)IdOf(item))">@TextOf(item)</MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public Func<TItem, int> IdOf { get; set; } = null!;
    [Parameter, EditorRequired] public Func<TItem, string> TextOf { get; set; } = null!;
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string? Display(int? id)
    {
        if (id is null) return "";
        foreach (var item in Items)
            if (IdOf(item) == id) return TextOf(item);
        return "";
    }
}
