@inherits LayoutComponentBase
@implements IDisposable
@inject CareService Care
@inject NavigationManager Navigation

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Toggle navigation" />
        <MudText Typo="Typo.h6" Class="ml-2">ClinicScheduler</MudText>
        <MudText Typo="Typo.caption" Class="ml-3 app-bar-sub d-none d-sm-flex">Houston Arthritis Center</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudTooltip Text="Notifications">
                    <MudBadge Content="_unread" Visible="@(_unread > 0)" Color="Color.Secondary" Overlap="true" Class="mr-3">
                        <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" Href="/notifications"
                                       aria-label="@($"Notifications, {_unread} unread")" />
                    </MudBadge>
                </MudTooltip>
                <MudText Typo="Typo.body2" Class="d-none d-sm-flex mr-2">@context.User.FindFirst(ClinicClaims.DisplayName)?.Value</MudText>
                <form method="post" action="/account/logout" class="d-inline">
                    <AntiforgeryToken />
                    <MudTooltip Text="Sign out">
                        <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Outlined.Logout" Color="Color.Inherit" aria-label="Sign out" />
                    </MudTooltip>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always" Class="app-drawer">
        <MudNavMenu Class="mt-3">
            <AuthorizeView Roles="@Roles.Staff">
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.SpaceDashboard">Overview</MudNavLink>
                <MudNavLink Href="/calendar" Icon="@Icons.Material.Outlined.CalendarViewWeek">Calendar</MudNavLink>
                <MudNavLink Href="/schedule" Icon="@Icons.Material.Outlined.CalendarMonth">Schedule</MudNavLink>
                <MudNavLink Href="/requests" Icon="@Icons.Material.Outlined.Inbox">Requests</MudNavLink>
                <MudNavLink Href="/waitlist" Icon="@Icons.Material.Outlined.HourglassTop">Waitlist</MudNavLink>
                <MudNavLink Href="/patients" Icon="@Icons.Material.Outlined.People">Patients</MudNavLink>
                <MudNavLink Href="/plans" Icon="@Icons.Material.Outlined.Assignment">Treatment plans</MudNavLink>
                <MudNavLink Href="/billing" Icon="@Icons.Material.Outlined.ReceiptLong">Billing</MudNavLink>
                <MudNavLink Href="/directory" Icon="@Icons.Material.Outlined.Apartment">Clinic directory</MudNavLink>
                <MudDivider Class="my-2" />
                <MudNavLink Href="/reports" Icon="@Icons.Material.Outlined.Insights">Reports</MudNavLink>
                <MudNavLink Href="/audit" Icon="@Icons.Material.Outlined.History">Audit log</MudNavLink>
                <MudNavLink Href="/rules" Icon="@Icons.Material.Outlined.Rule">Database rules</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="@Roles.Manager">
                <MudNavLink Href="/accounts" Icon="@Icons.Material.Outlined.ManageAccounts">Accounts</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="@Roles.Provider">
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Today">My day</MudNavLink>
                <MudNavLink Href="/calendar" Icon="@Icons.Material.Outlined.CalendarViewWeek">Calendar</MudNavLink>
                <MudNavLink Href="/notes" Icon="@Icons.Material.Outlined.EditNote">Visit notes</MudNavLink>
                <MudNavLink Href="/plans" Icon="@Icons.Material.Outlined.Assignment">Treatment plans</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="@Roles.Patient">
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Home">My care</MudNavLink>
                <MudNavLink Href="/request" Icon="@Icons.Material.Outlined.EventAvailable">Request a visit</MudNavLink>
                <MudNavLink Href="/my-invoices" Icon="@Icons.Material.Outlined.ReceiptLong">Invoices</MudNavLink>
            </AuthorizeView>
            <AuthorizeView>
                <MudNavLink Href="/notifications" Icon="@Icons.Material.Outlined.Notifications">
                    Notifications @if (_unread > 0) { <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ml-2 my-0">@_unread</MudChip> }
                </MudNavLink>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6 px-4 px-md-8">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error">Could not reach the database: @_error</MudAlert>
            }
            else
            {
                @Body
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _drawerOpen = true;
    private string? _error;
    private int _unread;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0f6e6e",
            Secondary = "#b45309",
            AppbarBackground = "#0c4f52",
            AppbarText = "#ffffff",
            Background = "#f5f7f7",
            Surface = "#ffffff",
            DrawerBackground = "#ffffff",
            TextPrimary = "#16282b",
            TextSecondary = "#55696c",
            Divider = "#dfe6e6",
            LinesDefault = "#dfe6e6",
            TableLines = "#e6ecec",
            Success = "#2e7d32",
            Error = "#b3261e",
            Warning = "#b45309",
            Info = "#1d5fa8",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Inter", "Segoe UI", "Helvetica", "Arial", "sans-serif"] },
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "8px", DrawerWidthLeft = "248px" },
    };

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnNavigated;
        await RefreshUnreadAsync();
    }

    // Keep the badge current as people move around (reading notifications, acting on requests)
    private async void OnNavigated(object? sender, LocationChangedEventArgs e)
    {
        await RefreshUnreadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshUnreadAsync()
    {
        if (AuthState is null || (await AuthState).User.Identity?.IsAuthenticated != true) return;
        try
        {
            _unread = await Care.UnreadCountAsync();
            _error = null;
        }
        catch (Exception ex) when (ex is Npgsql.NpgsqlException or InvalidOperationException)
        {
            _error = ex.GetBaseException().Message;
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnNavigated;
}
