@inject IBillingService BillingService
@inject IDbContextFactory<ClinicDbContext> DbFactory
@inject ISnackbar Snackbar

<MudDialog @bind-Visible="_visible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Add Line Item</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Required="true" />
        <MudNumericField @bind-Value="_quantity" Label="Quantity" Variant="Variant.Outlined" Min="1" Class="mt-3" />
        <MudNumericField @bind-Value="_unitPrice" Label="Unit Price ($)" Variant="Variant.Outlined" Min="0m"
                         Format="F2" Class="mt-3" />
        <MudTextField @bind-Value="_billingCode" Label="Billing Code (CPT)" Variant="Variant.Outlined" Class="mt-3"
                      Placeholder="e.g. 97110" />
        <MudSelect T="int?" @bind-Value="_therapyTypeId" Label="Therapy Type" Variant="Variant.Outlined"
                   Clearable="true" Class="mt-3">
            @foreach (var tt in _therapyTypes)
            {
                <MudSelectItem Value="@((int?)tt.Id)">@tt.Name</MudSelectItem>
            }
        </MudSelect>
        <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">
            Amount: @((_quantity * _unitPrice).ToString("C"))
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync"
                   Disabled="string.IsNullOrWhiteSpace(_description)">Add</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int InvoiceId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnAdded { get; set; }

    private bool _visible = true;
    private string _description = "";
    private int _quantity = 1;
    private decimal _unitPrice;
    private string _billingCode = "";
    private int? _therapyTypeId;
    private List<TherapyType> _therapyTypes = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _therapyTypes = await db.TherapyTypes.AsNoTracking().OrderBy(t => t.Name).ToListAsync();
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_description)) return;

        try
        {
            await BillingService.AddLineItemAsync(InvoiceId, _description, _quantity, _unitPrice,
                string.IsNullOrWhiteSpace(_billingCode) ? null : _billingCode, _therapyTypeId);
            await OnAdded.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task Close()
    {
        _visible = false;
        await OnClose.InvokeAsync();
    }
}
