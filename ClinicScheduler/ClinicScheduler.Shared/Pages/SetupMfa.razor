@page "/account/setup-mfa"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@using QRCoder
@inject UserManager<AppUser> UserManager
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Set Up Two-Factor Authentication</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-6">
    <MudItem xs="12" sm="10" md="7" lg="5">
        <MudPaper Elevation="2" Class="pa-6">
            <div class="d-flex align-center mb-5 gap-2">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => Nav.NavigateTo("/settings"))" />
                <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Set Up Authenticator App</MudText>
            </div>

            @if (_step == Step.ScanQr)
            {
                <MudStepper @bind-ActiveIndex="_stepIndex" Linear="false" Color="Color.Primary" Class="mb-5">
                    <MudStep Title="Scan" />
                    <MudStep Title="Verify" />
                    <MudStep Title="Recovery Codes" />
                </MudStepper>

                <MudAlert Severity="Severity.Info" Class="mb-4">
                    Install an authenticator app such as
                    <strong>Google Authenticator</strong>, <strong>Authy</strong>, or
                    <strong>Microsoft Authenticator</strong>, then scan the QR code below.
                </MudAlert>

                @if (_qrCodeBase64 is not null)
                {
                    <div class="d-flex justify-center mb-4">
                        <img src="data:image/png;base64,@_qrCodeBase64"
                             alt="QR code for authenticator app"
                             style="width:200px;height:200px;border:1px solid #eee;border-radius:8px;padding:8px;" />
                    </div>
                }

                <MudExpansionPanels Class="mb-5">
                    <MudExpansionPanel Text="Can't scan? Enter this key manually">
                        <MudText Typo="Typo.body2" Class="mb-2" Style="color:#666;">
                            Enter this key in your authenticator app:
                        </MudText>
                        <MudText Typo="Typo.body1"
                                 Style="font-family:monospace;font-size:1.1rem;letter-spacing:0.15em;font-weight:600;">
                            @_formattedKey
                        </MudText>
                    </MudExpansionPanel>
                </MudExpansionPanels>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="@GoToVerify">
                    Next — Enter Verification Code
                </MudButton>
            }
            else if (_step == Step.Verify)
            {
                <MudStepper @bind-ActiveIndex="_stepIndex" Linear="false" Color="Color.Primary" Class="mb-5">
                    <MudStep Title="Scan" />
                    <MudStep Title="Verify" />
                    <MudStep Title="Recovery Codes" />
                </MudStepper>

                <MudText Typo="Typo.body2" Class="mb-5" Style="color:#666;">
                    Enter the 6-digit code shown in your authenticator app to confirm setup.
                </MudText>

                @if (_errorMessage is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true"
                              CloseIconClicked="@(() => _errorMessage = null)">
                        @_errorMessage
                    </MudAlert>
                }

                <MudTextField @bind-Value="_verificationCode"
                              Label="Verification Code"
                              Placeholder="000000"
                              Variant="Variant.Outlined"
                              Class="mb-5"
                              MaxLength="6"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Pin"
                              OnKeyDown="@HandleKeyDown" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="VerifyAndEnableAsync" Disabled="_saving">
                    @(_saving ? "Verifying…" : "Enable Two-Factor Authentication")
                </MudButton>

                <MudButton Variant="Variant.Text" FullWidth="true" Class="mt-2"
                           OnClick="@(() => _step = Step.ScanQr)">
                    Back
                </MudButton>
            }
            else if (_step == Step.RecoveryCodes)
            {
                <MudStepper @bind-ActiveIndex="_stepIndex" Linear="false" Color="Color.Primary" Class="mb-5">
                    <MudStep Title="Scan" />
                    <MudStep Title="Verify" />
                    <MudStep Title="Recovery Codes" />
                </MudStepper>

                <MudAlert Severity="Severity.Success" Class="mb-2">
                    Two-factor authentication is now enabled!
                </MudAlert>

                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    <strong>Save these recovery codes now.</strong> They won't be shown again.
                    Each code can be used once if you lose access to your authenticator app.
                </MudAlert>

                <MudPaper Outlined="true" Class="pa-4 mb-5" Style="background:#f8f9fa;">
                    <MudGrid Spacing="1">
                        @foreach (var recoveryCode in _recoveryCodes)
                        {
                            <MudItem xs="6">
                                <MudText Typo="Typo.body1"
                                         Style="font-family:monospace;font-size:0.95rem;letter-spacing:0.1em;">
                                    @recoveryCode
                                </MudText>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="@(() => Nav.NavigateTo("/settings"))">
                    Done — Go to Settings
                </MudButton>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private enum Step { ScanQr, Verify, RecoveryCodes }

    private Step _step = Step.ScanQr;
    private int _stepIndex = 0;
    private string? _qrCodeBase64;
    private string _formattedKey = "";
    private string _verificationCode = "";
    private string? _errorMessage;
    private bool _saving;
    private List<string> _recoveryCodes = [];
    private AppUser? _user;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _user = await UserManager.GetUserAsync(authState.User);
        if (_user is null) { Nav.NavigateTo("/login"); return; }

        await GenerateQrCodeAsync();
    }

    private async Task GenerateQrCodeAsync()
    {
        if (_user is null) return;

        var key = await UserManager.GetAuthenticatorKeyAsync(_user);
        if (string.IsNullOrEmpty(key))
        {
            await UserManager.ResetAuthenticatorKeyAsync(_user);
            key = await UserManager.GetAuthenticatorKeyAsync(_user);
        }

        _formattedKey = FormatKey(key!);

        var email = await UserManager.GetEmailAsync(_user) ?? _user.UserName ?? "user";
        var totpUri = $"otpauth://totp/ClinicScheduler:{Uri.EscapeDataString(email)}" +
                      $"?secret={key}&issuer=ClinicScheduler&algorithm=SHA1&digits=6&period=30";

        using var qrGenerator = new QRCodeGenerator();
        var qrCodeData = qrGenerator.CreateQrCode(totpUri, QRCodeGenerator.ECCLevel.Q);
        using var qrCode = new PngByteQRCode(qrCodeData);
        _qrCodeBase64 = Convert.ToBase64String(qrCode.GetGraphic(20));
    }

    private void GoToVerify()
    {
        _step = Step.Verify;
        _stepIndex = 1;
    }

    private async Task VerifyAndEnableAsync()
    {
        if (_user is null) return;
        _errorMessage = null;

        var cleanCode = _verificationCode.Replace(" ", "").Replace("-", "");
        if (cleanCode.Length != 6 || !cleanCode.All(char.IsDigit))
        {
            _errorMessage = "Please enter a valid 6-digit code.";
            return;
        }

        _saving = true;
        try
        {
            var isValid = await UserManager.VerifyTwoFactorTokenAsync(
                _user,
                UserManager.Options.Tokens.AuthenticatorTokenProvider,
                cleanCode);

            if (!isValid)
            {
                _errorMessage = "Invalid code. Make sure your device clock is synced and try again.";
                return;
            }

            await UserManager.SetTwoFactorEnabledAsync(_user, true);

            var codes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(_user, 10);
            _recoveryCodes = codes!.ToList();

            _step = Step.RecoveryCodes;
            _stepIndex = 2;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await VerifyAndEnableAsync();
    }

    private static string FormatKey(string key)
    {
        var result = new System.Text.StringBuilder();
        for (int i = 0; i < key.Length; i++)
        {
            if (i > 0 && i % 4 == 0) result.Append(' ');
            result.Append(key[i]);
        }
        return result.ToString().ToUpperInvariant();
    }
}
