<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Allows the ClinicSchedulerV2 tests to call the tool methods directly -->
    <RootNamespace>ClinicScheduler.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runs against the ClinicSchedulerV2 database, where PostgreSQL enforces the rules -->
    <ProjectReference Include="..\..\ClinicSchedulerV2\ClinicSchedulerV2.Data\ClinicSchedulerV2.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
  </ItemGroup>

</Project>
