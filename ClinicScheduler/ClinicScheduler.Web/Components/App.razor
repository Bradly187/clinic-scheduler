<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <title>Clinic Scheduler</title>
    <meta name="description" content="Clinic Scheduler is a comprehensive platform for managing clinic appointments, patients, and staff." />
    <ResourcePreloader/>
    <link rel="stylesheet" href="/_content/ClinicScheduler.Shared/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="/_content/MudBlazor/MudBlazor.min.css"/>
    <link rel="stylesheet" href="/_content/ClinicScheduler.Shared/app.css"/>
    <link rel="stylesheet" href="/ClinicScheduler.Web.styles.css"/>
    <ImportMap/>
    <link rel="icon" type="image/png" href="/_content/ClinicScheduler.Shared/favicon.png"/>
    <HeadOutlet @rendermode="InteractiveServer"/>
</head>

<body>
<Routes @rendermode="InteractiveServer"/>
<ReconnectModal/>
<script src="/_content/MudBlazor/MudBlazor.min.js"></script>
@* .NET 10 fingerprints the Blazor boot script in published output; resolve the
   fingerprinted URL via Assets instead of hardcoding the friendly path *@
<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>